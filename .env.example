# --- PayPal (sandbox) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> create app
# leave these empty and the app runs on a fake PayPal so you can still click through
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
CURRENCY=USD

# --- AI ---
# easiest free option: a Gemini key from aistudio.google.com
GEMINI_API_KEY=

# or any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, OpenAI...)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

PORT=3000
